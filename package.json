{
  "name": "lightlms",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A lightweight, AI-integrated learning platform: courses, lessons and quizzes",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js",
    "dev": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.js",
    "create-user": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/cli.js create-user",
    "seed-demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/seed-demo.js",
    "test": "node --test server/test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "backup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/backup-cli.js backup",
    "backups": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/backup-cli.js backups",
    "verify-backup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/backup-cli.js verify-backup",
    "restore": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/backup-cli.js restore",
    "export-user": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/privacy-cli.js export",
    "erase-user": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/privacy-cli.js erase"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
