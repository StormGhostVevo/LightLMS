{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["public/js/**/*.js"]
}
