PORT=3000
DATABASE_PATH=data/lightlms.sqlite
# AI: "stub" (no external calls, default in dev), "anthropic", or "off"
AI_PROVIDER=stub
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Shown on certificates, and the time zone their dates use
ORG_NAME=
TIMEZONE=Australia/Sydney
# How many proxies are in front of the server (default 1 in production, 0 otherwise). Set 0 if there is no proxy.
TRUST_PROXY=
