PORT=3000
DATABASE_PATH=data/lightlms.sqlite
# AI: "stub" (no external calls, default in dev), "anthropic", or "off"
AI_PROVIDER=stub
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Shown on certificates, and the time zone their dates use
ORG_NAME=
TIMEZONE=Australia/Sydney
# Backups: where they go (default: a "backups" folder beside the database), how many to keep, and how often (0 = never).
# Backups on the same disk as the database do not protect you from losing the disk: copy them elsewhere too.
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_EVERY_HOURS=24
# Log detail: silent, error, warn, info (default) or debug. Logs are JSON lines on stdout.
LOG_LEVEL=
# How many proxies are in front of the server (default 1 in production, 0 otherwise). Set 0 if there is no proxy.
TRUST_PROXY=
