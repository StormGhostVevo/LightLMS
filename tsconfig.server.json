{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["server/**/*.js", "types/**/*.d.ts", "eslint.config.js"]
}
